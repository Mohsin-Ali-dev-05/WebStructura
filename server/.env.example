# Server environment variables
# Copy this file to .env and adjust values for your machine.
# Never commit .env — it is listed in .gitignore.

PORT=5000
NODE_ENV=development

# Local MongoDB only (WebStructura stays on localhost)
DB_URI=mongodb://127.0.0.1:27017/webstructura
# Legacy alias still supported by env.js if DB_URI is unset:
# MONGO_URI=mongodb://127.0.0.1:27017/webstructura

# JWT — use a long random string in real use; never commit real secrets
JWT_SECRET=change-me-to-a-long-random-dev-secret
JWT_EXPIRES_IN=7d

# Allowed React (Vite) origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Gmail SMTP (password reset emails)
# SMTP_USER = your full Gmail address
# SMTP_PASS = Google App Password (16 chars; enable 2FA first)
SMTP_USER=your.email@gmail.com
SMTP_PASS=
# Inbox that receives Contact form submissions (defaults to mohsinali2k21@gmail.com)
SUPPORT_EMAIL=mohsinali2k21@gmail.com

# Local Ollama (backend only — never send these to the React client)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Cloudinary (profile avatars). Required in production.
# In development without these, avatars are stored under server/uploads/.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public API URL used for locally stored avatar links (dev fallback)
PUBLIC_API_URL=http://localhost:5000
